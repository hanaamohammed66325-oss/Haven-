NEXT_PUBLIC_SUPABASE_URL=https://cseufbkuvhqrkjrhbvaj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_U4M8BJH04I2yJj3MIp0jFA_8UlSlYlr

NEXT_PUBLIC_PAYMENTS_MODE=mock
# Tap Payments Card Web SDK public key (safe for the frontend — never the
# secret key). Set the real pk_test_/pk_live_ value in Netlify's environment
# variables; that overrides this at build time. Leave empty here.
NEXT_PUBLIC_TAP_PUBLIC_KEY=
# Tap merchant id, required by the Card Web SDK (sent as the `mid` query
# param to sdk.tap.company) even though Tap's docs list it as optional —
# omitting it makes the SDK request a card page with an empty mid and it
# 400s. Set the real value in Netlify's environment variables.
NEXT_PUBLIC_TAP_MERCHANT_ID=
